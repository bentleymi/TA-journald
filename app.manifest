{
  "schemaVersion": "2.0.0",
  "info": {
    "title": "Journald Log-Plane Meta Add-on (disk usage, file growth)",
    "id": {
      "group": null,
      "name": "TA-journald",
      "version": "1.0.8"
    },
    "author": [
      {
        "name": "Michael \"JKat54\" Bentley",
        "email": "michael@bentleypc.com",
        "company": "BentleyPC LLC"
      }
    ],
    "releaseDate": "11/16/2026",
    "description": "Collects journald log-plane metadata: journal disk usage (journalctl --disk-usage), journal file count under /var/log/journal, total journal size, age of the oldest journal file, and the journald service state. Emits JSON events to index=main (sourcetype journald:status) and journald.* metrics (disk_kb, size_mb, file_count) to index=metrics (sourcetype journald:metrics) every 300s, with dashboards.",
