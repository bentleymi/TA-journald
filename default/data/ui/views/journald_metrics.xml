<dashboard version="1.1" theme="light">
  <label>TA-journald-logplane Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype journald:metrics); series prefixed 'journald.'.</description>
  <row>
    <panel type="html">
      <html><![CDATA[<div style="border:1px solid #cc7a00;background:#fff7ea;border-radius:6px;padding:10px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:12px">
<span style="font-weight:700;color:#b35c00">Commercial Use</span>
<span>Commercial or production use of TA-journald requires a paid license. Evaluation, personal, and lab use is free. See the BentleyPC Commercial License for full terms.</span>
<a href="https://bentleypc.com/TA-TA-journald/" target="_blank" rel="noopener" style="background:#cc7a00;color:#fff;padding:7px 16px;border-radius:5px;font-weight:700;text-decoration:none">Buy License</a>
<a href="https://bentleypc.com/TA-TA-journald/LICENSE.html" target="_blank" rel="noopener" style="color:#b35c00;font-weight:600;text-decoration:underline">License &amp; Terms</a>
</div>]]></html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Journal size (MB)</title>
      <chart>
        <search>
          <query>| mstats avg("journald.size_mb") as value where index=metrics by metric_name span=5m
| rename value as "journald.size_mb"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Journal files</title>
      <chart>
        <search>
          <query>| mstats avg("journald.file_count") as value where index=metrics by metric_name span=5m
| rename value as "journald.file_count"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Oldest journal age (hours)</title>
      <chart>
        <search>
          <query>| mstats avg("journald.oldest_age_hours") as value where index=metrics by metric_name span=5m
| rename value as "journald.oldest_age_hours"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Service active (0/1)</title>
      <chart>
        <search>
          <query>| mstats avg("journald.service_active") as value where index=metrics by metric_name span=5m
| rename value as "journald.service_active"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
</dashboard>
